{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CharTerm",
  "version": "0.8.7",
  "identifier": "com.charvez.charterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CharTerm",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Charlie M. Chavez. All Rights Reserved.",
    "publisher": "Charlie M. Chavez",
    "homepage": "https://github.com/iamcharvez/CharTerm",
    "shortDescription": "One Terminal. Every Connection.",
    "longDescription": "A modern terminal and remote connection manager for SSH, SFTP, Telnet, Serial, and local terminal workflows.",
    "licenseFile": "../LICENSE.md",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NTU0QTdCODU5OUY2ODYKUldTRzlwbUZlMHBWeUorWmhWa0ZGWHdaVUdYVXdpWVFENW55QlhuWEdkYVM2aGh1M1F6UHQ1TTgK",
      "endpoints": [
        "https://github.com/iamcharvez/CharTerm/releases/latest/download/latest.json"
      ]
    }
  }
}
